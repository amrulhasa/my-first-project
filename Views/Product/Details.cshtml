@section Scripts {

    <script>

        const stockLimit = @Model.StockQuantity;

        function changeQty(amount) {

            const input =
                document.getElementById("qtyInput");

            if (!input) {
                return;
            }

            let current =
                parseInt(input.value) || 1;

            let next =
                current + amount;

            if (next < 1) {
                next = 1;
            }

            if (next > stockLimit) {
                next = stockLimit;
            }

            input.value = next;
        }

    </script>

}