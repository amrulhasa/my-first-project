@model BDTechMarket.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-12 col-xl-10">

            <!-- HEADER -->

            <div class="mb-4">

                <a asp-action="Index"
                   class="text-decoration-none text-muted">

                    <i class="bi bi-arrow-left me-1"></i>
                    Back to Products

                </a>

                <h2 class="fw-bold mt-3 mb-1">
                    Edit Product
                </h2>

                <p class="text-muted mb-0">
                    Update product information, brand, category,
                    inventory and specifications.
                </p>

            </div>


            <!-- VALIDATION -->

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"
                 role="alert">
            </div>


            <!-- FORM -->

            <form asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Id" />


                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4 p-lg-5">

                        <div class="row g-4">


                            <!-- LEFT -->

                            <div class="col-lg-7">

                                <!-- PRODUCT NAME -->

                                <div class="mb-4">

                                    <label asp-for="Name"
                                           class="form-label fw-semibold">
                                        Product Name
                                    </label>

                                    <input asp-for="Name"
                                           class="form-control form-control-lg"
                                           autocomplete="off"
                                           placeholder="e.g. Samsung Galaxy S25" />

                                    <span asp-validation-for="Name"
                                          class="text-danger small">
                                    </span>

                                </div>


                                <!-- BRAND + SKU -->

                                <div class="row g-3">

                                    <div class="col-md-6">

                                        <label asp-for="BrandId"
                                               class="form-label fw-semibold">
                                            Brand
                                        </label>

                                        <select asp-for="BrandId"
                                                asp-items="ViewBag.BrandId"
                                                class="form-select">

                                            <option value="">
                                                Select Brand
                                            </option>

                                        </select>

                                        <span asp-validation-for="BrandId"
                                              class="text-danger small">
                                        </span>

                                        <div class="form-text">
                                            Only active brands can be selected.
                                        </div>

                                    </div>


                                    <div class="col-md-6">

                                        <label asp-for="SKU"
                                               class="form-label fw-semibold">
                                            SKU
                                        </label>

                                        <input asp-for="SKU"
                                               class="form-control bg-light"
                                               readonly />

                                        <div class="form-text">

                                            <i class="bi bi-lock-fill me-1"></i>
                                            SKU cannot be changed.

                                        </div>

                                    </div>

                                </div>


                                <!-- PRICE + STOCK -->

                                <div class="row g-3 mt-1">

                                    <div class="col-md-6">

                                        <label asp-for="Price"
                                               class="form-label fw-semibold">
                                            Price
                                        </label>

                                        <div class="input-group">

                                            <span class="input-group-text">
                                                ৳
                                            </span>

                                            <input asp-for="Price"
                                                   class="form-control"
                                                   type="number"
                                                   min="0.01"
                                                   step="0.01" />

                                        </div>

                                        <span asp-validation-for="Price"
                                              class="text-danger small">
                                        </span>

                                    </div>


                                    <div class="col-md-6">

                                        <label asp-for="StockQuantity"
                                               class="form-label fw-semibold">
                                            Stock Quantity
                                        </label>

                                        <input asp-for="StockQuantity"
                                               class="form-control"
                                               type="number"
                                               min="0"
                                               max="100000"
                                               step="1" />

                                        <span asp-validation-for="StockQuantity"
                                              class="text-danger small">
                                        </span>

                                    </div>

                                </div>


                                <!-- CATEGORY -->

                                <div class="mt-4">

                                    <label asp-for="CategoryId"
                                           class="form-label fw-semibold">
                                        Category
                                    </label>

                                    <select asp-for="CategoryId"
                                            asp-items="ViewBag.CategoryId"
                                            class="form-select">

                                        <option value="">
                                            Select Category
                                        </option>

                                    </select>

                                    <span asp-validation-for="CategoryId"
                                          class="text-danger small">
                                    </span>

                                </div>


                                <!-- DESCRIPTION -->

                                <div class="mt-4">

                                    <label asp-for="Description"
                                           class="form-label fw-semibold">
                                        Description
                                    </label>

                                    <textarea asp-for="Description"
                                              class="form-control"
                                              rows="6"
                                              maxlength="2000"
                                              placeholder="Enter product description, warranty information, etc."></textarea>

                                    <div class="d-flex justify-content-between">

                                        <span asp-validation-for="Description"
                                              class="text-danger small">
                                        </span>

                                        <small class="text-muted ms-auto">
                                            Maximum 2000 characters
                                        </small>

                                    </div>

                                </div>


                                <!-- ACTIVE -->

                                <div class="form-check form-switch mt-4">

                                    <input asp-for="IsActive"
                                           class="form-check-input"
                                           role="switch" />

                                    <label asp-for="IsActive"
                                           class="form-check-label fw-semibold">
                                        Product Active
                                    </label>

                                </div>


                                <div class="mt-2">

                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success">

                                            <i class="bi bi-check-circle me-1"></i>
                                            Currently Active

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">

                                            <i class="bi bi-pause-circle me-1"></i>
                                            Currently Inactive

                                        </span>
                                    }

                                </div>

                            </div>


                            <!-- RIGHT -->

                            <div class="col-lg-5">

                                <!-- CURRENT IMAGE -->

                                <div>

                                    <label class="form-label fw-semibold">
                                        Current Product Image
                                    </label>

                                    <div class="current-image-box">

                                        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                                        {
                                            <img src="@Model.ImageUrl"
                                                 alt="@Model.Name"
                                                 class="current-image" />
                                        }
                                        else
                                        {
                                            <div class="text-center text-muted">

                                                <i class="bi bi-image fs-1"></i>

                                                <div class="mt-2">
                                                    No image uploaded
                                                </div>

                                            </div>
                                        }

                                    </div>

                                </div>


                                <!-- REPLACE IMAGE -->

                                <div class="mt-4">

                                    <label asp-for="ImageFile"
                                           class="form-label fw-semibold">
                                        Replace Product Image
                                    </label>

                                    <input asp-for="ImageFile"
                                           id="imageInput"
                                           type="file"
                                           class="form-control"
                                           accept=".jpg,.jpeg,.png,.webp" />

                                    <span asp-validation-for="ImageFile"
                                          class="text-danger small">
                                    </span>

                                    <div class="form-text">
                                        JPG, JPEG, PNG or WEBP.
                                        Maximum 5 MB.
                                    </div>

                                </div>


                                <!-- PREVIEW -->

                                <div id="previewContainer"
                                     class="mt-3 d-none">

                                    <label class="form-label fw-semibold">
                                        New Image Preview
                                    </label>

                                    <img id="imagePreview"
                                         class="new-image-preview"
                                         alt="New product preview" />

                                </div>


                                <!-- SKU -->

                                <div class="card border-0 bg-light mt-4">

                                    <div class="card-body">

                                        <h6 class="fw-bold">

                                            <i class="bi bi-upc-scan me-2"></i>
                                            Product SKU

                                        </h6>

                                        <div class="sku-display">
                                            @Model.SKU
                                        </div>

                                        <p class="text-muted small mb-0 mt-2">
                                            This identifier is permanent and
                                            will not change when the product
                                            is edited.
                                        </p>

                                    </div>

                                </div>


                                <!-- SPECIFICATIONS -->

                                <div class="card border-0 bg-primary-subtle mt-3">

                                    <div class="card-body">

                                        <h6 class="fw-bold">
                                            <i class="bi bi-list-check me-2"></i>
                                            Product Specifications
                                        </h6>

                                        <p class="text-muted small mb-3">
                                            Manage RAM, storage, display,
                                            camera, battery and other
                                            technical specifications.
                                        </p>

                                        <a asp-controller="ProductSpecification"
                                           asp-action="Index"
                                           asp-route-productId="@Model.Id"
                                           class="btn btn-primary w-100">

                                            <i class="bi bi-list-check me-1"></i>
                                            Manage Specifications

                                        </a>

                                    </div>

                                </div>


                                <!-- PRODUCT INFORMATION -->

                                <div class="card border-0 bg-light mt-3">

                                    <div class="card-body">

                                        <h6 class="fw-bold">

                                            <i class="bi bi-info-circle me-2"></i>
                                            Product Information

                                        </h6>

                                        <div class="small text-muted">

                                            <div class="mb-2">

                                                <strong>Product ID:</strong>
                                                #@Model.Id

                                            </div>

                                            <div class="mb-2">

                                                <strong>Created:</strong>
                                                @Model.CreatedAt.ToString("dd MMM yyyy")

                                            </div>

                                            @if (Model.UpdatedAt.HasValue)
                                            {
                                                <div>

                                                    <strong>Last Updated:</strong>
                                                    @Model.UpdatedAt.Value.ToString("dd MMM yyyy HH:mm")

                                                </div>
                                            }

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- FOOTER -->

                    <div class="card-footer bg-white border-0 p-4">

                        <div class="d-flex flex-wrap justify-content-between gap-2">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4">

                                <i class="bi bi-arrow-left me-1"></i>
                                Cancel

                            </a>


                            <button type="submit"
                                    class="btn btn-primary px-4">

                                <i class="bi bi-save me-1"></i>
                                Save Changes

                            </button>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>


<style>

    .current-image-box {
        min-height: 300px;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding: 15px;
    }

    .current-image {
        width: 100%;
        height: 280px;
        object-fit: contain;
        border-radius: 8px;
    }

    .new-image-preview {
        width: 100%;
        height: 220px;
        object-fit: contain;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 10px;
        background: #f8f9fa;
    }

    .sku-display {
        font-family: monospace;
        font-size: 18px;
        font-weight: 700;
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 10px 12px;
    }

    .form-select,
    .form-control {
        border-radius: 8px;
    }

    .form-select:focus,
    .form-control:focus {
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.12);
    }

    .card {
        border-radius: 14px;
    }

</style>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        const imageInput =
            document.getElementById("imageInput");

        const imagePreview =
            document.getElementById("imagePreview");

        const previewContainer =
            document.getElementById("previewContainer");


        imageInput.addEventListener("change", function () {

            const file = this.files[0];

            if (!file) {

                previewContainer.classList.add("d-none");

                return;
            }


            // FILE SIZE

            if (file.size > 5 * 1024 * 1024) {

                alert("Image size cannot exceed 5 MB.");

                this.value = "";

                previewContainer.classList.add("d-none");

                return;
            }


            // FILE TYPE

            const allowedTypes = [
                "image/jpeg",
                "image/png",
                "image/webp"
            ];


            if (!allowedTypes.includes(file.type)) {

                alert(
                    "Only JPG, JPEG, PNG and WEBP images are allowed."
                );

                this.value = "";

                previewContainer.classList.add("d-none");

                return;
            }


            // PREVIEW

            const reader =
                new FileReader();


            reader.onload = function (event) {

                imagePreview.src =
                    event.target.result;

                previewContainer.classList.remove(
                    "d-none"
                );

            };


            reader.readAsDataURL(file);

        });

    </script>
}