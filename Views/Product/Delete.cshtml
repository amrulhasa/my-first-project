@model BDTechMarket.Models.Product

@{
    ViewData["Title"] = "Deactivate Product";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-7 col-lg-6">

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <div class="card-header bg-danger text-white p-4">

                    <h4 class="mb-0 fw-bold">
                        <i class="fas fa-ban me-2"></i>
                        Deactivate Product
                    </h4>

                </div>

                <div class="card-body p-4">

                    <div class="alert alert-warning border-0 rounded-3">

                        <i class="fas fa-info-circle me-2"></i>

                        This will hide the product from customers.
                        Historical order data will remain safe.

                    </div>

                    <div class="text-center mb-4">

                        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                        {
                            <img src="@Url.Content(Model.ImageUrl)"
                                 alt="@Model.Name"
                                 class="rounded-3 shadow-sm"
                                 style="width:180px;height:180px;object-fit:cover;" />
                        }
                        else
                        {
                            <div class="bg-light rounded-3 d-flex align-items-center justify-content-center mx-auto"
                                 style="width:180px;height:180px;">
                                <i class="fas fa-image fa-3x text-muted opacity-25"></i>
                            </div>
                        }

                    </div>

                    <dl class="row mb-4">

                        <dt class="col-sm-4">
                            Product
                        </dt>

                        <dd class="col-sm-8 fw-bold">
                            @Model.Name
                        </dd>

                        <dt class="col-sm-4">
                            SKU
                        </dt>

                        <dd class="col-sm-8">
                            @(!string.IsNullOrWhiteSpace(Model.SKU)
                                ? Model.SKU
                                : "Not assigned")
                        </dd>

                        <dt class="col-sm-4">
                            Category
                        </dt>

                        <dd class="col-sm-8">
                            @(Model.Category?.Name ?? "N/A")
                        </dd>

                        <dt class="col-sm-4">
                            Price
                        </dt>

                        <dd class="col-sm-8 fw-bold text-primary">
                            ৳@Model.Price.ToString("N2")
                        </dd>

                        <dt class="col-sm-4">
                            Stock
                        </dt>

                        <dd class="col-sm-8">
                            @Model.StockQuantity
                        </dd>

                    </dl>

                    <form asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-danger flex-grow-1 rounded-pill">

                                <i class="fas fa-ban me-1"></i>
                                Deactivate Product

                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary rounded-pill px-4">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>