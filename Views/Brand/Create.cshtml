@model BDTechMarket.Models.Brand

@{
    ViewData["Title"] = "Create Brand";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-7 col-lg-6">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-dark text-white p-4">

                    <h5 class="mb-0 fw-bold">

                        <i class="fas fa-tag me-2"></i>

                        Create New Brand

                    </h5>

                </div>

                <div class="card-body p-4">

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"></div>


                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">

                                Brand Name

                            </label>

                            <input asp-for="Name"
                                   class="form-control form-control-lg"
                                   placeholder="e.g. Samsung, Apple, ASUS"
                                   autofocus />

                            <span asp-validation-for="Name"
                                  class="text-danger small"></span>

                        </div>


                        <div class="mb-4">

                            <label asp-for="LogoUrl"
                                   class="form-label fw-semibold">

                                Logo URL

                            </label>

                            <input asp-for="LogoUrl"
                                   class="form-control"
                                   placeholder="https://example.com/logo.png" />

                            <span asp-validation-for="LogoUrl"
                                  class="text-danger small"></span>

                        </div>


                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="form-label fw-semibold">

                                Description

                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Short brand description..."></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger small"></span>

                        </div>


                        <div class="mb-4">

                            <label asp-for="DisplayOrder"
                                   class="form-label fw-semibold">

                                Display Order

                            </label>

                            <input asp-for="DisplayOrder"
                                   type="number"
                                   min="1"
                                   class="form-control" />

                            <span asp-validation-for="DisplayOrder"
                                  class="text-danger small"></span>

                        </div>


                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary rounded-pill px-4">

                                <i class="fas fa-save me-1"></i>

                                Save Brand

                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary rounded-pill px-4">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}