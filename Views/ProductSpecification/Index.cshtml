@model IEnumerable<BDTechMarket.Models.ProductSpecification>

@{
    var product = ViewBag.Product as BDTechMarket.Models.Product;

    ViewData["Title"] = "Product Specifications";
}

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <a asp-controller="Product"
               asp-action="Edit"
               asp-route-id="@product?.Id"
               class="text-decoration-none text-muted">

                <i class="fas fa-arrow-left me-1"></i>
                Back to Product
            </a>

            <h2 class="fw-bold mt-3 mb-1">
                Product Specifications
            </h2>

            <p class="text-muted mb-0">
                Manage technical specifications for
                <strong>@product?.Name</strong>.
            </p>
        </div>

        <div>

            <a asp-action="Create"
               asp-route-productId="@product?.Id"
               class="btn btn-primary rounded-pill px-4">

                <i class="fas fa-plus me-1"></i>
                Add Specification

            </a>

        </div>

    </div>


    <!-- Product Summary -->

    @if (product != null)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">

            <div class="card-body p-4">

                <div class="row align-items-center">

                    <div class="col-md-8">

                        <div class="d-flex align-items-center gap-3">

                            <div class="rounded-3 bg-primary-subtle
                                        d-flex align-items-center justify-content-center"
                                 style="width:55px;height:55px;">

                                <i class="fas fa-box text-primary fa-lg"></i>

                            </div>

                            <div>

                                <h5 class="fw-bold mb-1">
                                    @product.Name
                                </h5>

                                <div class="text-muted small">

                                    SKU:
                                    <strong>
                                        @(product.SKU ?? "N/A")
                                    </strong>

                                    @if (product.Category != null)
                                    {
                                        <span class="mx-2">•</span>

                                        <span>
                                            @product.Category.Name
                                        </span>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-4 text-md-end mt-3 mt-md-0">

                        <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill">

                            @Model.Count() Specifications

                        </span>

                    </div>

                </div>

            </div>

        </div>
    }


    <!-- Specifications -->

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        @if (Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th style="width:80px;">
                                #
                            </th>

                            <th>
                                Specification
                            </th>

                            <th>
                                Value
                            </th>

                            <th style="width:130px;">
                                Order
                            </th>

                            <th style="width:180px;">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var specification in Model)
                        {
                            <tr>

                                <td class="text-muted fw-semibold">

                                    @specification.Id

                                </td>

                                <td>

                                    <strong>
                                        @specification.Name
                                    </strong>

                                </td>

                                <td>

                                    <span class="text-muted">
                                        @specification.Value
                                    </span>

                                </td>

                                <td>

                                    <span class="badge bg-light text-dark border">

                                        @specification.DisplayOrder

                                    </span>

                                </td>

                                <td>

                                    <div class="d-flex gap-2">

                                        <a asp-action="Edit"
                                           asp-route-id="@specification.Id"
                                           class="btn btn-sm btn-outline-warning rounded-circle"
                                           title="Edit">

                                            <i class="fas fa-edit"></i>

                                        </a>


                                        <form asp-action="Delete"
                                              asp-route-id="@specification.Id"
                                              method="post"
                                              onsubmit="return confirm('Are you sure you want to delete this specification?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger rounded-circle"
                                                    title="Delete">

                                                <i class="fas fa-trash"></i>

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <div class="mb-3">

                    <i class="fas fa-list-check fa-3x text-muted"></i>

                </div>

                <h5 class="fw-bold">
                    No specifications yet
                </h5>

                <p class="text-muted mb-4">
                    Add technical specifications for this product.
                </p>

                <a asp-action="Create"
                   asp-route-productId="@product?.Id"
                   class="btn btn-primary rounded-pill px-4">

                    <i class="fas fa-plus me-1"></i>
                    Add First Specification

                </a>

            </div>
        }

    </div>

</div>