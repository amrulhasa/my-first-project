@model BDTechMarket.Models.ProductSpecification

@{
    var product = ViewBag.Product as BDTechMarket.Models.Product;

    ViewData["Title"] = "Add Specification";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-12 col-lg-8">

            <div class="mb-4">

                <a asp-action="Index"
                   asp-route-productId="@Model.ProductId"
                   class="text-decoration-none text-muted">

                    <i class="fas fa-arrow-left me-1"></i>
                    Back to Specifications

                </a>

                <h2 class="fw-bold mt-3 mb-1">
                    Add Specification
                </h2>

                <p class="text-muted mb-0">

                    Add a technical specification for
                    <strong>@product?.Name</strong>.

                </p>

            </div>


            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>


            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4 p-lg-5">

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="ProductId" />


                        <!-- Specification Name -->

                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">

                                Specification Name

                            </label>

                            <input asp-for="Name"
                                   class="form-control form-control-lg"
                                   placeholder="e.g. RAM"
                                   autocomplete="off" />

                            <div class="form-text">
                                Example: RAM, Storage, Display, Camera, Battery
                            </div>

                            <span asp-validation-for="Name"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Value -->

                        <div class="mb-4">

                            <label asp-for="Value"
                                   class="form-label fw-semibold">

                                Value

                            </label>

                            <input asp-for="Value"
                                   class="form-control form-control-lg"
                                   placeholder="e.g. 12 GB"
                                   autocomplete="off" />

                            <span asp-validation-for="Value"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Display Order -->

                        <div class="mb-4">

                            <label asp-for="DisplayOrder"
                                   class="form-label fw-semibold">

                                Display Order

                            </label>

                            <input asp-for="DisplayOrder"
                                   type="number"
                                   min="1"
                                   max="1000"
                                   class="form-control"
                                   />

                            <div class="form-text">
                                Smaller numbers appear first.
                            </div>

                            <span asp-validation-for="DisplayOrder"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Buttons -->

                        <div class="d-flex flex-wrap gap-2">

                            <button type="submit"
                                    class="btn btn-primary px-4">

                                <i class="fas fa-save me-1"></i>
                                Save Specification

                            </button>

                            <a asp-action="Index"
                               asp-route-productId="@Model.ProductId"
                               class="btn btn-outline-secondary px-4">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}