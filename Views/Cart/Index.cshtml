@model BDTechMarket.Models.ViewModels.ShoppingCartVM

@{
    ViewData["Title"] = "Your Shopping Cart";
    var grandTotal = Model.OrderTotal;
}

<div class="container mt-5 mb-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">
                <i class="fas fa-shopping-cart me-2 text-primary"></i>
                Your Shopping Cart
            </h2>

            <p class="text-muted small mb-0">
                Review your items before proceeding to checkout
            </p>
        </div>

        <div class="text-end">
            <span class="badge bg-primary fs-6 rounded-pill px-4 shadow-sm">
                @Model.ListCart.Sum(x => x.Count) Items
            </span>
        </div>
    </div>

    @if (Model.ListCart != null && Model.ListCart.Any())
    {
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

            <!-- Cart Table -->
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="bg-dark text-white">
                        <tr>
                            <th class="ps-4 py-3">Product</th>
                            <th class="py-3">Price</th>
                            <th class="py-3">Quantity</th>
                            <th class="py-3">Subtotal</th>
                            <th class="text-center py-3">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.ListCart)
                        {
                            <tr>

                                <!-- Product -->
                                <td class="ps-4">

                                    <div class="d-flex align-items-center">

                                        <img src="@Url.Content(item.Product?.ImageUrl ?? "/images/no-image.png")"
                                             alt="@item.Product?.Name"
                                             class="rounded-3 me-3 border shadow-sm cart-img-hover"
                                             style="width:70px;
                                                    height:70px;
                                                    object-fit:cover;
                                                    background:#fff;" />

                                        <div>

                                            <h6 class="mb-1 fw-bold">
                                                @item.Product?.Name
                                            </h6>

                                            @if (item.Product?.Category != null)
                                            {
                                                <small class="badge bg-light text-dark fw-normal border">
                                                    @item.Product.Category.Name
                                                </small>
                                            }

                                        </div>

                                    </div>

                                </td>


                                <!-- Price -->
                                <td>

                                    <span class="fw-semibold">
                                        @item.Price.ToString("N0")
                                    </span>

                                    <small class="text-muted">
                                        BDT
                                    </small>

                                </td>


                                <!-- Quantity -->
                                <td>

                                    <div class="d-flex align-items-center">

                                        <!-- Minus -->
                                        <form asp-controller="Cart"
                                              asp-action="Minus"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="cartId"
                                                   value="@item.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-secondary px-2"
                                                    title="Decrease quantity">

                                                <i class="fas fa-minus"></i>

                                            </button>

                                        </form>


                                        <!-- Quantity -->
                                        <span class="badge bg-white text-dark border px-3 py-2 fw-bold mx-2">
                                            @item.Count
                                        </span>


                                        <!-- Plus -->
                                        <form asp-controller="Cart"
                                              asp-action="Plus"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="cartId"
                                                   value="@item.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-secondary px-2"
                                                    title="Increase quantity">

                                                <i class="fas fa-plus"></i>

                                            </button>

                                        </form>

                                    </div>

                                </td>


                                <!-- Subtotal -->
                                <td class="fw-bold text-primary">

                                    @item.Total.ToString("N0")

                                    <small class="text-muted">
                                        BDT
                                    </small>

                                </td>


                                <!-- Remove -->
                                <td class="text-center">

                                    <form asp-controller="Cart"
                                          asp-action="Remove"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Remove this item from cart?');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <button type="submit"
                                                class="btn btn-link text-danger p-0 text-decoration-none"
                                                title="Remove item">

                                            <i class="fas fa-trash-alt fs-5"></i>

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- Cart Footer -->
            <div class="card-footer bg-light p-4 border-top-0">

                <div class="row align-items-center">

                    <!-- Left Actions -->
                    <div class="col-md-6 mb-3 mb-md-0">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-outline-dark rounded-pill px-4 me-2">

                            <i class="fas fa-chevron-left me-2 small"></i>
                            Back to Shop

                        </a>


                        <!-- Clear Cart -->
                        <form asp-controller="Cart"
                              asp-action="ClearCart"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('Empty your entire cart?');">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-danger rounded-pill px-4">

                                <i class="fas fa-trash-alt me-1"></i>
                                Clear Cart

                            </button>

                        </form>

                    </div>


                    <!-- Right Summary -->
                    <div class="col-md-6 text-md-end">

                        <div class="mb-3">

                            <span class="text-muted me-2">
                                Estimated Total:
                            </span>

                            <span class="h3 fw-bold text-success">
                                @grandTotal.ToString("N0") BDT
                            </span>

                        </div>


                        <a asp-controller="Cart"
                           asp-action="Checkout"
                           class="btn btn-primary btn-lg rounded-pill px-5 shadow transition-btn">

                            Proceed to Checkout

                            <i class="fas fa-arrow-right ms-2 small"></i>

                        </a>

                    </div>

                </div>

            </div>

        </div>
    }
    else
    {
        <!-- Empty Cart -->
        <div class="card border-0 shadow-sm rounded-4 text-center py-5">

            <div class="card-body py-5">

                <div class="mb-4">

                    <i class="fas fa-shopping-bag fa-5x text-muted opacity-25"></i>

                </div>

                <h3 class="fw-bold text-dark">
                    Your cart is empty
                </h3>

                <p class="text-muted mb-4 px-5">
                    It looks like you haven't added any products
                    to your cart yet.
                </p>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-primary btn-lg rounded-pill px-5">

                    <i class="fas fa-shopping-bag me-2"></i>
                    Start Shopping

                </a>

            </div>

        </div>
    }

</div>


<style>

    .cart-img-hover {
        transition: transform 0.2s ease;
    }

    .cart-img-hover:hover {
        transform: scale(1.08);
    }

    .transition-btn {
        transition: all 0.2s ease;
    }

    .transition-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(13, 110, 253, 0.3) !important;
    }

</style>